{
  "name": "argus-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/kill-dev.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=verbose --reporter=json --outputFile.json=coverage/test-results.json",
    "test:contract": "vitest run tests/contract",
    "launch": "tsx src/cli/launch.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.0",
    "@fastify/static": "9.1.3",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.5",
    "@fastify/websocket": "11.2.0",
    "@microsoft/teams.apps": "^2.0.7",
    "@slack/socket-mode": "^2.0.6",
    "@slack/web-api": "^7.15.1",
    "better-sqlite3": "12.8.0",
    "chokidar": "3.6.0",
    "dotenv": "^17.4.2",
    "fastify": "5.8.5",
    "jose": "^6.2.2",
    "js-yaml": "4.1.1",
    "koffi": "^2.16.1",
    "node-pty": "^1.1.0",
    "pino": "9.14.0",
    "pino-pretty": "11.3.0",
    "ps-list": "8.1.1",
    "uuid": "^11.1.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.15",
    "@types/supertest": "6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "3.1.1",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.8",
    "vite-node": "3.1.1",
    "vitest": "3.1.1"
  }
}
