{
  "name": "argus-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=verbose --reporter=json --outputFile.json=coverage/test-results.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config ../playwright.config.ts",
    "pretest:e2e:real": "node ../scripts/kill-port.mjs 7412",
    "test:e2e:real": "playwright test --config ../playwright.real.config.ts",
    "test:e2e:ui": "playwright test --config ../playwright.config.ts --ui --ui-host=localhost --ui-port=9323",
    "pretest:e2e:real:ui": "node ../scripts/kill-port.mjs 7412",
    "test:e2e:real:ui": "playwright test --config ../playwright.real.config.ts --ui --ui-host=localhost --ui-port=9324",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint --fix src/**/*.{ts,tsx}",
    "format": "prettier --write src/**/*.{ts,tsx}"
  },
  "dependencies": {
    "@tanstack/react-query": "5.96.0",
    "lucide-react": "1.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-joyride": "3.0.2",
    "react-markdown": "10.1.0",
    "react-router-dom": "6.30.3",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "3.1.1",
    "autoprefixer": "10.4.27",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.0.1",
    "postcss": "8.5.8",
    "prettier": "3.8.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.8",
    "vite-node": "3.1.1",
    "vite-plugin-istanbul": "^8.0.0",
    "vitest": "3.1.1"
  }
}
